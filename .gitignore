# Root level gitignore

# Database files
backend/todos.db
backend/*.db

# Python
__pycache__/
*.py[cod]
*$py.class
backend/venv/
backend/.env

# Node.js
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Temporary files
*.tmp
*.temp
.vercel
